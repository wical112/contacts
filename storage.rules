rules_version = '2';
// 私人商用聯絡簿 — 卡片相片
// 同 firestore.rules 對齊：只 owner email + own uid path
service firebase.storage {
  match /b/{bucket}/o {
    // Google Sign-In 嘅 email 本身已由 Google 驗過 → 唔再 gate email_verified
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['yuwaiho112@gmail.com'];
    }
    match /users/{uid}/cards/{file} {
      allow read, write: if isOwner() && request.auth.uid == uid
        && (request.resource == null
            || (request.resource.size < 4 * 1024 * 1024
                && request.resource.contentType.matches('image/.*')));
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
